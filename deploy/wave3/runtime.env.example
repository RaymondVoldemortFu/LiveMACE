# Copy to .wave3/runtime.env, chmod 600, and supply this deployment's credentials.
WAVE3_PRODUCTION=true
SANDBOX_INSTANCE=alpha-arena-wave3
WAVE3_MODEL=deepseek-flash
DEEPSEEK_THINKING_MODE=disabled
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
API_KEY=
BASE_URL=https://api.deepseek.com/v1
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_MAX_QUOTE_AGE_SECONDS=120
# Generate once; retain securely alongside MySQL backups (Fernet.generate_key()).
API_KEY_CIPHER_KEY=
# Generate a separate random token for the loopback operator API.
DECISION_OPERATOR_TOKEN=
AUDIT_MODEL=deepseek-flash
AUDIT_API_KEY=
AUDIT_BASE_URL=
EVAL_LLM_MODEL=deepseek-flash
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
AGENT_MAX_CONCURRENCY=2
AGENT_ROUND_TIMEOUT_SECONDS=600
AGENT_LLM_CALL_LIMIT=80
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_REQUEST_MAX_RETRIES=1
PUBLIC_API_TOOL_LIMIT=20
AI_TRADE_INTERVAL_SECONDS=14400
BASELINE_TRADE_INTERVAL_SECONDS=300
# Set a deliberate timezone-aware ISO timestamp before enabling AI scheduling.
AI_TRADE_FIRST_EXECUTION_TIME=
ENABLE_ACCOUNT_CREATION_API=true
ENABLE_ACCOUNT_UPDATE_API=true
ENABLE_MANUAL_ORDER_API=true
