{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_steps": {"type": "integer", "minimum": 1, "default": 100},
    "tool_routing_enabled": {"type": "boolean", "default": true},
    "memory_enabled": {"type": ["boolean", "null"], "default": null},
    "step_reminder_threshold": {"type": "integer", "minimum": 0, "default": 5},
    "include_simulation_notice": {"type": "boolean", "default": false},
    "agent_name": {"type": ["string", "null"], "default": null},
    "user_id": {"type": ["string", "integer", "null"], "default": null}
  }
}
