{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmark.local/schema/prompt-index-v1.json",
  "title": "Benchmark Prompt Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "prompts"],
  "properties": {
    "api_version": {"const": 1},
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/prompt"}
    },
    "profiles": {
      "type": "array",
      "maxItems": 128,
      "default": [],
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 200
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 100
    },
    "variable": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 100
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "file"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "file": {"type": "string", "minLength": 1, "maxLength": 500},
        "required_variables": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "default": [],
          "items": {"$ref": "#/$defs/variable"}
        },
        "optional_variables": {
          "type": "object",
          "maxProperties": 128,
          "default": {},
          "propertyNames": {"$ref": "#/$defs/variable"}
        },
        "content_type": {
          "type": "string",
          "enum": ["text/plain", "text/markdown"],
          "default": "text/plain"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id"],
      "properties": {
        "prompt_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "slots"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "slots": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/variable"},
          "additionalProperties": {"$ref": "#/$defs/selection"}
        }
      }
    }
  }
}
