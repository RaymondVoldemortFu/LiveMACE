# Required for account creation and runtime LLM calls
API_KEY=your-primary-api-key
BASE_URL=https://api.example.com/v1

# Optional: single mode default account params
# python create_accounts_from_env.py --mode single
ACCOUNT_DEFAULT_ACCOUNT_TYPE=AI
ACCOUNT_DEFAULT_AGENT_TYPE=react
ACCOUNT_DEFAULT_MEMORY_ENABLED=false
ACCOUNT_DEFAULT_TOOL_ROUTING_ENABLED=true
ACCOUNT_DEFAULT_ENABLE_RULE_AWARE=false
ACCOUNT_DEFAULT_IS_ACTIVE=true

# Optional: all-combinations mode account params
# python create_accounts_from_env.py --mode all-combinations
# 2D list style: one row = one combination to create.
# Positional CSV format per row:
# account_type,agent_type,memory_enabled,tool_routing_enabled,enable_rule_aware,is_active
ACCOUNT_COMBO_ROW_1=AI,react,false,true,false,true
ACCOUNT_COMBO_ROW_2=AI,multi_agent,true,true,true,true
# You can also use key=value format per row:
# ACCOUNT_COMBO_ROW_3=account_type=AI;agent_type=react;memory_enabled=false;tool_routing_enabled=true;enable_rule_aware=false;is_active=true

# Optional integrations
TAVILY_API_KEY=
RAPIDAPI_KEY=
APYHUB_KEY=
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USER=
BRIGHTDATA_PASS=

# Optional market providers
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_KEY_BOKER=
ALPACA_SECRET_BOKER=

# Optional eval configs
DELTA_T=0
EVAL_LLM_MODEL=gemini-3-pro-preview
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
