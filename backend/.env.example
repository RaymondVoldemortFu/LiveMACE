# Required for account creation and runtime LLM calls
API_KEY=your-primary-api-key
BASE_URL=https://api.example.com/v1

# Database (recommended for production: MySQL)
# For local development (host machine):
# DATABASE_URL=mysql+pymysql://alpha:your-password@localhost:3306/alpha_arena?charset=utf8mb4
# For app container in docker compose, compose file injects host=mysql automatically.
# For local sqlite fallback:
# DATABASE_URL=sqlite:///./data.db
DATABASE_URL=mysql+pymysql://alpha:your-password@localhost:3306/alpha_arena?charset=utf8mb4
DB_POOL_SIZE=80
DB_MAX_OVERFLOW=120
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Deployment feature flags for API capabilities
# true: enabled, false: disabled
ENABLE_ACCOUNT_CREATION_API=true
ENABLE_ACCOUNT_UPDATE_API=true
ENABLE_MANUAL_ORDER_API=true

# Agent runtime controls
AGENT_MAX_CONCURRENCY=25
PUBLIC_API_TOOL_LIMIT=80

# Agent trading interval (seconds, default: 14400 = 4 hours)
AI_TRADE_INTERVAL_SECONDS=14400

# Eval checkpoint intervals (comma-separated seconds, default: 900,3600,86400 = 15min,1h,1day)
EVAL_CHECKPOINT_INTERVAL_SECONDS=900,3600,86400
# Eval checkpoint polling interval (seconds, default: 30)
EVAL_CHECKPOINT_POLL_SECONDS=30

# Optional: single mode default account params
# python script/create_accounts_from_env.py --mode single
ACCOUNT_DEFAULT_ACCOUNT_TYPE=AI
ACCOUNT_DEFAULT_AGENT_TYPE=react
ACCOUNT_DEFAULT_MEMORY_ENABLED=false
ACCOUNT_DEFAULT_TOOL_ROUTING_ENABLED=true
ACCOUNT_DEFAULT_ENABLE_RULE_AWARE=false
ACCOUNT_DEFAULT_IS_ACTIVE=true

# Optional: all-combinations mode account params
# python script/create_accounts_from_env.py --mode all-combinations
# Store combination definitions in CSV and provide file path here.
# Required CSV columns:
# account_type,agent_type,memory_enabled,tool_routing_enabled,enable_rule_aware,is_active
ACCOUNT_COMBO_CSV_PATH=./config/account_combinations.example.csv

# Optional integrations
TAVILY_API_KEY=
RAPIDAPI_KEY=
APYHUB_KEY=
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USER=
BRIGHTDATA_PASS=

# Optional market providers
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_KEY_BOKER=
ALPACA_SECRET_BOKER=

# Optional eval configs
DELTA_T=0
EVAL_LLM_MODEL=gemini-3-pro-preview
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=

# Memory system (Pinecone cloud vector database)
PINECONE_API_KEY=
