# Required for account creation and runtime LLM calls
API_KEY=your-primary-api-key
BASE_URL=https://api.example.com/v1

# Optional: single mode default account params
# python create_accounts_from_env.py --mode single
ACCOUNT_DEFAULT_ACCOUNT_TYPE=AI
ACCOUNT_DEFAULT_AGENT_TYPE=react
ACCOUNT_DEFAULT_MEMORY_ENABLED=false
ACCOUNT_DEFAULT_TOOL_ROUTING_ENABLED=true
ACCOUNT_DEFAULT_ENABLE_RULE_AWARE=false
ACCOUNT_DEFAULT_IS_ACTIVE=true

# Optional: all-combinations mode account params
# python create_accounts_from_env.py --mode all-combinations
# Use comma-separated values for Cartesian product.
ACCOUNT_COMBO_ACCOUNT_TYPE=AI
ACCOUNT_COMBO_AGENT_TYPE=react,multi_agent
ACCOUNT_COMBO_MEMORY_ENABLED=false,true
ACCOUNT_COMBO_TOOL_ROUTING_ENABLED=true
ACCOUNT_COMBO_ENABLE_RULE_AWARE=false,true
ACCOUNT_COMBO_IS_ACTIVE=true

# Optional integrations
TAVILY_API_KEY=
RAPIDAPI_KEY=
APYHUB_KEY=
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USER=
BRIGHTDATA_PASS=

# Optional market providers
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_KEY_BOKER=
ALPACA_SECRET_BOKER=

# Optional eval configs
DELTA_T=0
EVAL_LLM_MODEL=gemini-3-pro-preview
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
