# ==============================
# Required for account creation and runtime LLM calls
# ==============================
API_KEY=your-primary-api-key
BASE_URL=https://api.example.com/v1

# ==============================
# Optional: all-combinations mode
# create_accounts_from_env.py --mode all-combinations
# Will build Cartesian products across all API_KEY* x BASE_URL*
# ==============================
API_KEY_OPENAI=your-openai-compatible-key
API_KEY_GEMINI=your-gemini-gateway-key
BASE_URL_OPENAI=https://api.openai.com/v1
BASE_URL_GATEWAY=https://api.example-gateway.com/v1

# ==============================
# Optional integrations
# ==============================
TAVILY_API_KEY=

# ==============================
# Optional market providers
# ==============================
ALPACA_KEY=
ALPACA_SECRET=


# ==============================
# Optional eval configs
# ==============================
DELTA_T=0
EVAL_LLM_MODEL=gemini-3-pro-preview
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
