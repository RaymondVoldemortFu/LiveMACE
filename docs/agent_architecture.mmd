classDiagram
    %% 类定义
    class TradingAgent {
        +LLMClient llm
        +ToolRegistry tools
        +int max_steps
        +run(portfolio, prices) Dict
    }

    class SearchSubAgent {
        +TavilyClient client
        +LLMClient llm_client
        +int max_steps
        +run(query, topic, ...) Dict
        -_search_tool(query, ...)
        -_extract_tool(url)
    }

    class EnvWrapper {
        <<Module>>
        +register_default_tools(registry, db, account_id)
        +get_market_snapshot(symbol)
        +get_account_state()
        +consult_search_agent(query, ...)
    }

    class LLMClient {
        +OpenAI client
        +String model
        +call(messages, tools) Message
    }

    class ToolRegistry {
        +register(tool)
        +get(name) Callable
        +openai_tools List
    }

    %% 关系定义
    TradingAgent --> LLMClient : uses
    TradingAgent --> ToolRegistry : uses
    
    EnvWrapper ..> ToolRegistry : registers tools into
    EnvWrapper ..> SearchSubAgent : creates & wraps
    
    SearchSubAgent --> LLMClient : uses
    
    %% 决策流程备注
    note for TradingAgent "核心循环:\n1. 分析 Portfolio/Prices\n2. 调用 LLM\n3. 执行工具(含子智能体)\n4. 解析 <FINAL_JSON>"
    note for SearchSubAgent "子循环:\n1. 分析查询意图\n2. 调用搜索/提取工具\n3. 总结信息 <FINAL_RESPONSE>"

